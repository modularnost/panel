{
  "components": {
    "schemas": {
      "Deploy": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "finished_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "new_digest": {
            "type": "string"
          },
          "old_digest": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "stack": {
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "triggered_by": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "service",
          "source",
          "status",
          "started_at"
        ],
        "type": "object"
      },
      "Join": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string"
          },
          "command": {
            "description": "Run this on the machine that should join; it contains the join token",
            "type": "string"
          },
          "role": {
            "enum": [
              "worker",
              "manager"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "address",
          "command"
        ],
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "Module": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "description": "Why the manifest could not be fetched",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nav_entries": {
            "items": {
              "$ref": "#/components/schemas/NavEntry"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "service",
          "ok",
          "nav_entries",
          "permissions"
        ],
        "type": "object"
      },
      "ModuleInstall": {
        "additionalProperties": false,
        "properties": {
          "env": {
            "description": "KEY=value entries",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "image": {
            "type": "string"
          },
          "name": {
            "description": "Shown in the panel and used in the module's URL",
            "type": "string"
          },
          "network": {
            "description": "Overlay network; the panel's own when empty",
            "type": "string"
          },
          "port": {
            "description": "The module's HTTP port; 8080 when empty",
            "type": "string"
          },
          "service": {
            "description": "Swarm service name; \u003cname\u003e_module when empty",
            "type": "string"
          }
        },
        "required": [
          "name",
          "image"
        ],
        "type": "object"
      },
      "ModuleInstalled": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "service"
        ],
        "type": "object"
      },
      "NavEntry": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "path"
        ],
        "type": "object"
      },
      "Node": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string"
          },
          "availability": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "leader": {
            "type": "boolean"
          },
          "os": {
            "type": "string"
          },
          "role": {
            "enum": [
              "worker",
              "manager"
            ],
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "hostname",
          "role",
          "leader",
          "status",
          "availability"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ProblemBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ProblemBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Redeploy": {
        "additionalProperties": false,
        "properties": {
          "new_digest": {
            "type": "string"
          },
          "old_digest": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "service",
          "warnings"
        ],
        "type": "object"
      },
      "Service": {
        "additionalProperties": false,
        "properties": {
          "desired": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "digest": {
            "type": "string"
          },
          "healthy": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "mode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "running": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "stack": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "image",
          "mode",
          "running",
          "desired",
          "healthy"
        ],
        "type": "object"
      },
      "Stack": {
        "additionalProperties": false,
        "properties": {
          "desired": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "healthy": {
            "type": "boolean"
          },
          "managed": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "running": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "service_count": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "service_count",
          "running",
          "desired",
          "healthy",
          "managed"
        ],
        "type": "object"
      },
      "StackCompose": {
        "additionalProperties": false,
        "properties": {
          "compose": {
            "description": "The compose file; services missing from it are removed",
            "type": "string"
          }
        },
        "required": [
          "compose"
        ],
        "type": "object"
      },
      "StackDetail": {
        "additionalProperties": false,
        "properties": {
          "compose": {
            "type": "string"
          },
          "desired": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "healthy": {
            "type": "boolean"
          },
          "managed": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "running": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "service_count": {
            "format": "int64",
            "type": "integer"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/Service"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_by": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "service_count",
          "running",
          "desired",
          "healthy",
          "managed",
          "services"
        ],
        "type": "object"
      },
      "StackResult": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "output": {
            "description": "What docker stack deploy printed",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "TaskStats": {
        "additionalProperties": false,
        "properties": {
          "block_read": {
            "description": "Cumulative bytes read from block devices",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "block_write": {
            "description": "Cumulative bytes written to block devices",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "cpu": {
            "description": "Percent of one core, as docker stats reports it",
            "format": "double",
            "type": "number"
          },
          "error": {
            "description": "Set on a row for a node that could not be reached",
            "type": "string"
          },
          "mem": {
            "description": "Bytes",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "mem_limit": {
            "description": "Bytes; 0 when no limit is set",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "net_rx": {
            "description": "Cumulative received bytes",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "net_tx": {
            "description": "Cumulative transmitted bytes",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "node": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "slot": {
            "format": "int64",
            "type": "integer"
          },
          "stack": {
            "type": "string"
          }
        },
        "required": [
          "node",
          "service",
          "slot",
          "cpu",
          "mem",
          "mem_limit",
          "net_rx",
          "net_tx",
          "block_read",
          "block_write"
        ],
        "type": "object"
      },
      "Token": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "description": "The token's own role; empty means it inherits the user's",
            "type": "string"
          },
          "user_id": {
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "username",
          "name"
        ],
        "type": "object"
      },
      "Traefik": {
        "additionalProperties": false,
        "properties": {
          "cert_resolver": {
            "description": "Empty serves plain HTTP",
            "type": "string"
          },
          "entrypoint": {
            "description": "Letters, digits, hyphens and underscores",
            "type": "string"
          },
          "host": {
            "description": "Host name; empty for none",
            "type": "string"
          },
          "port": {
            "description": "Container port; 0 for none",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "host",
          "port",
          "entrypoint",
          "cert_resolver"
        ],
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "Webhook": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "force_update",
              "stack_redeploy"
            ],
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "image_pattern": {
            "type": "string"
          },
          "last_triggered_at": {
            "format": "date-time",
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "stack": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "action",
          "path",
          "created_at"
        ],
        "type": "object"
      },
      "WebhookCreate": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "force_update",
              "stack_redeploy"
            ],
            "type": "string"
          },
          "image_pattern": {
            "description": "Stored, but not enforced yet",
            "type": "string"
          },
          "service": {
            "description": "Required for force_update",
            "type": "string"
          },
          "stack": {
            "description": "Required for stack_redeploy",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      },
      "cookie": {
        "in": "cookie",
        "name": "panel_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "modularnost",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Sign in; the session cookie is set on the response"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "End the session"
      }
    },
    "/api/v1/deploys": {
      "get": {
        "operationId": "list-deploys",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "format": "int64",
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Deploy"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Recent deploys, newest first"
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "The signed-in user"
      }
    },
    "/api/v1/modules": {
      "get": {
        "operationId": "list-modules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Module"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Installed modules with their manifests"
      },
      "post": {
        "operationId": "install-module",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModuleInstall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleInstalled"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Deploy a module image as a service the panel will pick up"
      }
    },
    "/api/v1/modules/{name}": {
      "delete": {
        "operationId": "uninstall-module",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Remove the module's service; its image and data are not touched"
      }
    },
    "/api/v1/nodes": {
      "get": {
        "operationId": "list-nodes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Node"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Cluster members"
      }
    },
    "/api/v1/nodes/join": {
      "get": {
        "operationId": "get-join",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "role",
            "schema": {
              "default": "worker",
              "enum": [
                "worker",
                "manager"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Join"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "The command that adds a server to the cluster"
      }
    },
    "/api/v1/services": {
      "get": {
        "operationId": "list-services",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Service"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
